{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  "permission": {
    "bash": {
      "gh api -X GET *": "allow",
      "gh api -X PATCH *": "allow",
      "gh api -X POST *": "allow",
      "gh api -X PUT *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh search *": "allow",
      "git blame *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "playwright-cli check *": "allow",
      "playwright-cli click *": "allow",
      "playwright-cli close": "allow",
      "playwright-cli console*": "allow",
      "playwright-cli fill *": "allow",
      "playwright-cli go-back": "allow",
      "playwright-cli go-forward": "allow",
      "playwright-cli goto http://localhost:*": "allow",
      "playwright-cli hover *": "allow",
      "playwright-cli network*": "allow",
      "playwright-cli open http://localhost:*": "allow",
      "playwright-cli open": "allow",
      "playwright-cli press *": "allow",
      "playwright-cli reload": "allow",
      "playwright-cli screenshot*": "allow",
      "playwright-cli select *": "allow",
      "playwright-cli snapshot*": "allow",
      "playwright-cli type *": "allow",
      "playwright-cli uncheck *": "allow",
      "pnpm build *": "allow",
      "pnpm clean *": "allow",
      "pnpm format *": "allow",
      "pnpm lint *": "allow",
      "pnpm test *": "allow",
      "pnpm type-check *": "allow",
    },
  },
}
